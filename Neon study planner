
import os
import json
from datetime import date
from kivy.app import App
from kivy.metrics import dp
from kivy.core.window import Window
from kivy.utils import get_color_from_hex
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.gridlayout import GridLayout
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.uix.progressbar import ProgressBar
from kivy.uix.scrollview import ScrollView

BG = "#070D20"
PANEL = "#101B39"
BLUE = "#0866FF"
CYAN = "#00D9FF"
WHITE = "#F1F6FF"
MUTED = "#94A9CC"
GREEN = "#16845B"
RED = "#A51F45"


def color(hex_color):
    return get_color_from_hex(hex_color)


class NeonStudyPlanner(App):
    def build(self):
        Window.clearcolor = color(BG)
        self.title = "Neon Study Planner"

        self.data_file = os.path.join(
            self.user_data_dir, "planner_data.json"
        )
        self.tasks = []
        self.timetable = []
        self.load_data()

        self.root_box = BoxLayout(
            orientation="vertical",
            padding=dp(14),
            spacing=dp(10)
        )

        self.header = Label(
            text="[b]NEON STUDY PLANNER[/b]",
            markup=True,
            font_size="25sp",
            color=color(CYAN),
            size_hint_y=None,
            height=dp(48)
        )
        self.root_box.add_widget(self.header)

        self.date_label = Label(
            text="LEVEL UP YOUR LEARNING  |  " + str(date.today()),
            font_size="13sp",
            color=color(MUTED),
            size_hint_y=None,
            height=dp(28)
        )
        self.root_box.add_widget(self.date_label)

        self.progress_label = Label(
            text="STUDY PROGRESS: 0% (0/0)",
            font_size="17sp",
            color=color(CYAN),
            size_hint_y=None,
            height=dp(35)
        )
        self.root_box.add_widget(self.progress_label)

        self.progress = ProgressBar(
            max=100, value=0,
            size_hint_y=None, height=dp(12)
        )
        self.root_box.add_widget(self.progress)

        tabs = GridLayout(
            cols=2, spacing=dp(8),
            size_hint_y=None, height=dp(46)
        )
        self.tasks_tab = self.make_button(
            "STUDY TASKS", PANEL, self.show_tasks
        )
        self.time_tab = self.make_button(
            "TIMETABLE", BLUE, self.show_timetable
        )
        tabs.add_widget(self.tasks_tab)
        tabs.add_widget(self.time_tab)
        self.root_box.add_widget(tabs)

        self.content = BoxLayout(orientation="vertical", spacing=dp(8))
        self.root_box.add_widget(self.content)

        self.show_tasks()
        return self.root_box

    def make_button(self, text, bg, callback):
        btn = Button(
            text=text,
            background_normal="",
            background_color=color(bg),
            color=color(WHITE),
            font_size="15sp",
            bold=True,
            size_hint_y=None,
            height=dp(46)
        )
        btn.bind(on_release=callback)
        return btn

    def make_input(self, hint):
        return TextInput(
            hint_text=hint,
            multiline=False,
            size_hint_y=None,
            height=dp(46),
            padding=[dp(12), dp(12)],
            background_normal="",
            background_active="",
            background_color=color(PANEL),
            foreground_color=color(WHITE),
            hint_text_color=color(MUTED),
            cursor_color=color(CYAN),
            font_size="16sp"
        )

    def load_data(self):
        try:
            with open(self.data_file, "r", encoding="utf-8") as f:
                saved = json.load(f)
            self.tasks = saved.get("tasks", [])
            self.timetable = saved.get("timetable", [])
        except (OSError, ValueError, TypeError):
            self.tasks = []
            self.timetable = []

    def save_data(self):
        os.makedirs(self.user_data_dir, exist_ok=True)
        with open(self.data_file, "w", encoding="utf-8") as f:
            json.dump({
                "tasks": self.tasks,
                "timetable": self.timetable
            }, f, ensure_ascii=False, indent=2)

    def update_progress(self):
        total = len(self.tasks)
        done = sum(1 for task in self.tasks if task["done"])
        percent = int(done * 100 / total) if total else 0
        self.progress.value = percent
        self.progress_label.text = (
            f"STUDY PROGRESS: {percent}% ({done}/{total})"
        )

    def clear_content(self):
        self.content.clear_widgets()

    def show_tasks(self, *_):
        self.clear_content()
        self.tasks_tab.background_color = color(BLUE)
        self.time_tab.background_color = color(PANEL)

        self.task_input = self.make_input("Subject / study task...")
        self.content.add_widget(self.task_input)

        self.content.add_widget(self.make_button(
            "+ ADD STUDY TASK", BLUE, self.add_task
        ))

        scroll = ScrollView()
        self.task_list = GridLayout(
            cols=1, spacing=dp(7),
            size_hint_y=None, padding=[0, dp(4)]
        )
        self.task_list.bind(
            minimum_height=self.task_list.setter("height")
        )
        scroll.add_widget(self.task_list)
        self.content.add_widget(scroll)

        self.content.add_widget(self.make_button(
            "CLEAR ALL TASKS", RED, self.clear_tasks
        ))
        self.refresh_tasks()

    def add_task(self, *_):
        text = self.task_input.text.strip()
        if not text:
            self.progress_label.text = "PLEASE ENTER A TASK"
            return

        self.tasks.append({"text": text, "done": False})
        self.save_data()
        self.task_input.text = ""
        self.refresh_tasks()

    def refresh_tasks(self):
        self.task_list.clear_widgets()
        if not self.tasks:
            self.task_list.add_widget(Label(
                text="No tasks yet. Add your first task!",
                color=color(MUTED),
                size_hint_y=None, height=dp(60)
            ))

        for index, task in enumerate(self.tasks):
            row = BoxLayout(
                size_hint_y=None, height=dp(52), spacing=dp(6)
            )
            status = "DONE: " if task["done"] else ""
            bg = GREEN if task["done"] else PANEL
            toggle = self.make_button(
                status + task["text"], bg,
                lambda btn, i=index: self.toggle_task(i)
            )
            delete = self.make_button(
                "X", RED,
                lambda btn, i=index: self.delete_task(i)
            )
            delete.size_hint_x = 0.18
            row.add_widget(toggle)
            row.add_widget(delete)
            self.task_list.add_widget(row)

        self.update_progress()

    def toggle_task(self, index):
        self.tasks[index]["done"] = not self.tasks[index]["done"]
        self.save_data()
        self.refresh_tasks()

    def delete_task(self, index):
        del self.tasks[index]
        self.save_data()
        self.refresh_tasks()

    def clear_tasks(self, *_):
        self.tasks = []
        self.save_data()
        self.refresh_tasks()

    def show_timetable(self, *_):
        self.clear_content()
        self.tasks_tab.background_color = color(PANEL)
        self.time_tab.background_color = color(BLUE)

        self.subject_input = self.make_input("Subject (e.g. Maths)")
        self.time_input = self.make_input("Time (e.g. 5:00 PM)")
        self.content.add_widget(self.subject_input)
        self.content.add_widget(self.time_input)
        self.content.add_widget(self.make_button(
            "+ ADD TIMETABLE ENTRY", BLUE, self.add_timetable
        ))

        scroll = ScrollView()
        self.time_list = GridLayout(
            cols=1, spacing=dp(7),
            size_hint_y=None, padding=[0, dp(4)]
        )
        self.time_list.bind(
            minimum_height=self.time_list.setter("height")
        )
        scroll.add_widget(self.time_list)
        self.content.add_widget(scroll)
        self.refresh_timetable()

    def add_timetable(self, *_):
        subject = self.subject_input.text.strip()
        time = self.time_input.text.strip()

        if not subject or not time:
            self.progress_label.text = "ENTER SUBJECT AND TIME"
            return

        self.timetable.append({"subject": subject, "time": time})
        self.save_data()
        self.subject_input.text = ""
        self.time_input.text = ""
        self.refresh_timetable()

    def refresh_timetable(self):
        self.time_list.clear_widgets()

        if not self.timetable:
            self.time_list.add_widget(Label(
                text="Your timetable will appear here.",
                color=color(MUTED),
                size_hint_y=None, height=dp(60)
            ))

        for index, entry in enumerate(self.timetable):
            row = BoxLayout(
                size_hint_y=None, height=dp(52), spacing=dp(6)
            )
            label = Label(
                text=entry["time"] + "  |  " + entry["subject"],
                color=color(WHITE),
                halign="left",
                font_size="15sp"
            )
            label.bind(size=lambda obj, size: setattr(
                obj, "text_size", (size[0], None)
            ))
            delete = self.make_button(
                "X", RED,
                lambda btn, i=index: self.delete_timetable(i)
            )
            delete.size_hint_x = 0.18
            row.add_widget(label)
            row.add_widget(delete)
            self.time_list.add_widget(row)

    def delete_timetable(self, index):
        del self.timetable[index]
        self.save_data()
        self.refresh_timetable()


if __name__ == "__main__":
    NeonStudyPlanner().run()
